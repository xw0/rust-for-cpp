msgid ""
"// A tuple struct: fields are .0, .1, ... Great for type-safe wrappers.\n"
msgstr "// 元组结构体：字段是 .0、.1……非常适合做类型安全的包装。\n"

#: src/foundations/values-and-types.md:230
msgid "// A unit struct: no fields, zero size.\n"
msgstr "// 单元结构体：没有字段，大小为零。\n"

